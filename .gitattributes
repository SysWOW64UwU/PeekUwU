# Normalise text files to LF in both the repository and the working tree.
# This overrides the machine-level core.autocrlf=true, which otherwise makes
# git rewrite LF as CRLF on checkout and warn on every add.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ai binary
*.psd binary
*.woff binary
*.woff2 binary
*.zip binary
*.xpi binary
*.mp4 binary
