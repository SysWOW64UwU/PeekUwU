{
    "name": "PeekUwU",
    "version": "1.0.0",
    "manifest_version": 3,
    "description": "Removes Reddit's NSFW login walls, blur overlays and blocking modals, so nothing stands between you and the content.",
    "icons": {
        "16": "src/icon/icon16.png",
        "32": "src/icon/icon32.png",
        "48": "src/icon/icon48.png",
        "128": "src/icon/icon128.png"
    },
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_title": "PeekUwU",
        "default_icon": {
            "16": "src/icon/icon16.png",
            "32": "src/icon/icon32.png",
            "48": "src/icon/icon48.png"
        }
    },
    "permissions": ["storage", "activeTab", "scripting"],
    "content_scripts": [
        {
            "run_at": "document_start",
            "matches": [
                "*://*.reddit.com/*"
            ],
            "js": ["src/js/uncensor.js"]
        }
    ]
}
